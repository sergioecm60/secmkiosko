# Respaldos de la base de datos.
# Todo lo que esté acá se IGNORA, menos la carpeta ejemplo/.
# Motivo: los respaldos automáticos contienen datos reales del negocio
# (productos, costos de compra, márgenes, ventas, proveedores).
# Subirlos a un repositorio público los deja expuestos de forma permanente.
datos/*
!datos/ejemplo/

# Archivos de diagnostico y pruebas locales
_diag.php
_prueba.php
*.log

# Sistema
Thumbs.db
desktop.ini
.DS_Store
$RECYCLE.BIN/
ehthumbs.db
Thumbs.db:encryptable

# Editores
.vscode/
.idea/
*.swp
*~

# Node /Composer (por si en el futuro se usan)
node_modules/
vendor/
